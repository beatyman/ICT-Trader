# ---------------------------------------------------------------------------
# ICT Realtime Paper Trader - copy to .env and edit. All values are optional.
# Keep comments on their own line: Docker env_file parsers do not strip
# trailing comments consistently.
# ---------------------------------------------------------------------------

# demo | live
REALTIME_MODE=demo
# spot | futures
BINANCE_MARKET=spot
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT,DOGEUSDT
INTERVALS=15m,1h,4h,1d
STRATEGY_INTERVAL=15m
# 1d_4h_15m requires BOOTSTRAP_BARS>=8000 (1D cloud = 52+26 daily bars)
ICT_STACK=4h_15m

# Data bootstrap. 5000 x 15m ~= 52 days; enough for the 4H cloud.
BOOTSTRAP_BARS=5000
BOOTSTRAP_BARS_FAST=320
# Seconds per simulated bar; 15s keeps six symbols within one CPU envelope.
DEMO_SPEED=15.0
# 0=auto: 1800 for 4H stack, 8000 for 1D stack
STRATEGY_EVAL_WINDOW=0
REDIS_CLOSED_KEEP=1000
DEMO_SUBTICKS=6
# binance | synthetic
DEMO_SEED_SOURCE=binance

# Local Docker middleware
REDIS_URL=redis://127.0.0.1:6379/0
CLICKHOUSE_HOST=127.0.0.1
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=ict
CLICKHOUSE_BATCH_SIZE=500
CLICKHOUSE_FLUSH_SECONDS=2
CLICKHOUSE_RETENTION_DAYS=365

# Risk / execution (paper only)
INITIAL_EQUITY=100000
RISK_PCT=0.005
MAX_POSITION_PCT=0.30
MAX_OPEN_POSITIONS=5
MAX_DAILY_LOSS_PCT=0.03
COMMISSION_BPS=10
SLIPPAGE_BPS=2
ICT_ALLOW_SHORT=false
ICT_MIN_GRADE=3
ICT_MIN_CONFLUENCE=2
PAPER_TRADE=true

# Dashboard
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8080
# Browser snapshot cadence; latest candle is merged client-side from this feed.
BROADCAST_SECONDS=1.0
LOG_LEVEL=INFO

# Optional, on-demand risk review. The key stays server-side and is never
# exposed to the browser. The model cannot place or modify orders.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# API model id for DeepSeek-V4.1-Flash
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT=90
DEEPSEEK_MAX_TOKENS=4000
DEEPSEEK_EFFORT=low
