# ---------------------------------------------------------------------------
# ICT Realtime Paper Trader - copy to .env and edit.  All values are optional.
# ---------------------------------------------------------------------------
REALTIME_MODE=demo                 # demo | live
BINANCE_MARKET=spot                # spot | futures
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT,DOGEUSDT
INTERVALS=15m,1h,4h,1d
STRATEGY_INTERVAL=15m
ICT_STACK=4h_15m                   # 1d_4h_15m requires a longer bootstrap

# Data bootstrap. 5000 x 15m ~= 52 days; enough for the 4H cloud.
BOOTSTRAP_BARS=5000
BOOTSTRAP_BARS_FAST=320
DEMO_SPEED=15.0                    # seconds per simulated bar (6 symbols fit)
STRATEGY_EVAL_WINDOW=0             # 0=auto: 1800 for 4H stack, 6500 for 1D stack
DEMO_SUBTICKS=6
DEMO_SEED_SOURCE=binance           # binance | synthetic

# Local Docker middleware
REDIS_URL=redis://127.0.0.1:6379/0
CLICKHOUSE_HOST=127.0.0.1
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=ict
CLICKHOUSE_BATCH_SIZE=500
CLICKHOUSE_FLUSH_SECONDS=2
CLICKHOUSE_RETENTION_DAYS=365

# Risk / execution (paper only)
INITIAL_EQUITY=100000
RISK_PCT=0.005
MAX_POSITION_PCT=0.30
MAX_OPEN_POSITIONS=5
MAX_DAILY_LOSS_PCT=0.03
COMMISSION_BPS=10
SLIPPAGE_BPS=2
ICT_ALLOW_SHORT=false
ICT_MIN_GRADE=3
ICT_MIN_CONFLUENCE=2
PAPER_TRADE=true

# Dashboard
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8080
LOG_LEVEL=INFO

# Reserved. The current build never calls an LLM and the key is never exposed
# to the browser. Model-assisted review will be added behind an explicit flag.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
