<clickhouse>
  <profiles>
    <default>
      <!-- Query-level guardrails: the app never needs more than this. -->
      <max_memory_usage>1073741824</max_memory_usage>
      <max_threads>2</max_threads>
      <max_block_size>8192</max_block_size>
      <max_insert_block_size>8192</max_insert_block_size>
      <max_download_threads>2</max_download_threads>
      <max_parallel_replicas>1</max_parallel_replicas>
      <log_queries>0</log_queries>
      <log_query_threads>0</log_query_threads>
      <readonly>0</readonly>
    </default>
  </profiles>
  <!-- Local-only convenience user. Do not expose ports 8123/9000 publicly. -->
  <users>
    <default>
      <password></password>
      <networks>
        <ip>::/0</ip>
      </networks>
      <profile>default</profile>
      <quota>default</quota>
      <access_management>1</access_management>
    </default>
  </users>
</clickhouse>
